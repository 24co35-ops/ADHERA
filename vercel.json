{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Content-Type": "application/javascript",
        "Service-Worker-Allowed": "/"
      },
      "dest": "frontend/sw.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "frontend/assets/favicons/favicon.ico"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "frontend/assets/favicons/favicon-180x180.png"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/site.webmanifest",
      "dest": "frontend/site.webmanifest"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
